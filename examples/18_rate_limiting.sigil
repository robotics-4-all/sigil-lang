// Example 18: Rate Limiting
//
// The `RATE` stage limits message throughput using a token bucket algorithm.
// Syntax:  RATE <limit> per <duration> [ON_EXCESS: drop|warn|error]
//
// - Placed AFTER FILTER, BEFORE GROUP_BY in the PIPELINE order
// - Token bucket refills at (limit / period) tokens per second
// - Default ON_EXCESS is "drop" (silently discard)
// - "warn" logs a warning before dropping
// - "error" logs an error before dropping

BROKER sensors
    HOST: "localhost"
    PORT: 1883
;

// Basic RATE limiting: allow 100 messages per second
PIPELINE rate_basic
    SOURCE FROM sensors :: "sensors/temperature"
    |> RATE 100 PER 1s
    |> SINK TO sensors :: "sensors/throttled"
;

// Rate limiting with warning: 50 messages per 10 seconds
PIPELINE rate_with_warning
    SOURCE FROM sensors :: "sensors/pressure"
    |> FILTER msg.value > 0
    |> RATE 50 PER 10s ON_EXCESS: WARN
    |> WINDOW tumbling(30s)
    |> AGGREGATE {
        avg_pressure = avg(msg.value),
        sample_count = count()
    }
    |> MAP {
        pressure = avg_pressure,
        samples = sample_count
    }
    |> SINK TO sensors :: "sensors/pressure_agg"
;

// Strict RATE limiting with error logging
PIPELINE rate_strict
    SOURCE FROM sensors :: "sensors/critical"
    |> RATE 10 PER 1s ON_EXCESS: ERROR
    |> SINK TO sensors :: "alerts/critical"
;

