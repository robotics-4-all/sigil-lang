// Example 22: Stream Join — Enrich orders with customer data
//
// Demonstrates the JOIN stage which merges messages from two
// different topics based on a matching key within a time WINDOW.
// After joining, both `msg` (primary) and `other` (joined) fields
// are available in downstream stages.
//
// Join syntax:
//   |> JOIN BROKER :: "topic"
//       on msg.key == other.key
//       within DURATION
//       type: inner | left
//   end
//
// The `??` (null-coalesce) operator provides defaults for
// potentially missing fields from the joined stream.

BROKER local
    HOST: "localhost"
    PORT: 1883
;

PIPELINE enrich_orders
    SOURCE FROM local :: "orders/new"
    |> JOIN local :: "customers/profiles"
        ON msg.customer_id == other.id
        WITHIN 30 s
        TYPE: inner
    ;
    |> FILTER other.active == true
    |> MAP {
        order_id = msg.order_id,
        customer_name = other.name ?? "unknown",
        customer_email = other.email,
        amount = msg.amount
    }
    |> SINK TO local :: "orders/enriched"
;
