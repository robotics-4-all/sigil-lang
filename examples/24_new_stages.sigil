/*
 * Example 24 — New Pipeline Stages
 * ================================
 * Demonstrates the 4 new PIPELINE stages:
 * FLATTEN, DISTINCT, THROTTLE, and SAMPLE.
 *
 * CONCEPTS INTRODUCED:
 *   - FLATTEN expands an array field into individual messages
 *   - DISTINCT deduplicates messages by a field value within a time WINDOW
 *   - THROTTLE limits message throughput with optional buffering
 *   - SAMPLE probabilistic sampling of messages (percentage-based)
 *
 * STAGE ORDER:
 *   SOURCE → DEDUPLICATE → FILTER → RATE → FLATTEN → DISTINCT → THROTTLE →
 *   SAMPLE → GROUP_BY → WINDOW → AGGREGATE → ACCUMULATE → HAVING → MAP → SINK
 */

BROKER local
    HOST: "localhost"
    PORT: 1883
;

// Pipeline 1: flatten_orders — Flatten nested order items
// Expands an array of items into individual messages for downstream processing.
PIPELINE flatten_orders
    SOURCE FROM local :: "orders/raw"

    // Expand the 'items' array field into individual messages
    |> FLATTEN msg.items

    // Extract fields from the now-flattened message
    |> MAP {
        item_name = msg.item_name,
        quantity = msg.quantity,
        price = msg.price
    }

    |> SINK TO local :: "orders/items"
;

// Pipeline 2: distinct_events — Deduplicate events by ID
// Ensures that only unique event IDs are processed within a 10-minute WINDOW.
PIPELINE distinct_events
    SOURCE FROM local :: "events/raw"

    // Filter out test events before deduplication
    |> FILTER msg.status != "test"

    // Only allow one message per event_id every 10 minutes
    |> DISTINCT msg.event_id WITHIN 10m

    |> SINK TO local :: "events/unique"
;

// Pipeline 3: throttled_alerts — Throttle alert messages with buffering
// Limits the RATE of high-severity alerts to prevent downstream flooding.
PIPELINE throttled_alerts
    SOURCE FROM local :: "alerts/raw"

    // Only process high-severity alerts
    |> FILTER msg.severity > 3

    // Limit to 5 alerts per second. If exceeded, buffer up to 200 messages.
    |> THROTTLE 5 PER 1s OVERFLOW: BUFFER BUFFER: 200

    |> SINK TO local :: "alerts/throttled"
;

// Pipeline 4: sampled_telemetry — Sample high-volume telemetry
// Reduces data volume by only processing a random 10% of incoming messages.
PIPELINE sampled_telemetry
    SOURCE FROM local :: "telemetry/raw"

    // Probabilistically keep only 10% of messages
    |> SAMPLE 10%

    // Aggregate the sampled data over 1-minute windows
    |> WINDOW tumbling(1m)
    |> AGGREGATE {
        avg_value = avg(msg.value),
        sample_count = count()
    }

    |> MAP {
        avg_value = avg_value,
        sample_count = sample_count
    }

    |> SINK TO local :: "telemetry/sampled"
;

// Pipeline 5: combined_pipeline — Demonstrate multiple new stages together
// A complex PIPELINE showing how the new stages interact in the required order.
PIPELINE combined_pipeline
    SOURCE FROM local :: "data/raw"

    // 1. Expand nested readings
    |> FLATTEN msg.readings

    // 2. Deduplicate by sensor_id within 5 minutes
    |> DISTINCT msg.sensor_id WITHIN 5m

    // 3. Sample 50% of the unique readings
    |> SAMPLE 50%

    // 4. Aggregate over 30-second windows
    |> WINDOW tumbling(30s)
    |> AGGREGATE {
        avg_val = avg(msg.value),
        min_val = min(msg.value),
        max_val = max(msg.value),
        total = count()
    }

    // 5. Format the output
    |> MAP {
        avg_val = avg_val,
        min_val = min_val,
        max_val = max_val,
        total = total
    }

    |> SINK TO local :: "data/processed"
;
