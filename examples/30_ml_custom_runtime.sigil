/*
 * Example 30 — Custom ML Runtime
 * ================================
 * Uses a user-provided Python module as the inference backend.
 *
 * RUNTIME: custom — loads an arbitrary Python file via importlib.
 *   The module must expose:  predict(input_dict) -> list
 *
 * SCENARIO:
 *   An energy trading platform receives market tick data.
 *   A proprietary pricing model (not ONNX/sklearn/torch-compatible)
 *   is wrapped in a Python module that implements predict().
 *   The model outputs a fair-value estimate and a confidence band.
 *   Ticks where the market price deviates significantly from the
 *   model's fair value are flagged as trading signals.
 *
 * CUSTOM MODULE INTERFACE (models/pricing_model.py):
 *   def predict(features: dict) -> list:
 *       # features = {"spot_price": 42.1, "volume": 1200, ...}
 *       fair_value = ...
 *       confidence = ...
 *       return [fair_value, confidence]
 *
 * INPUT:  {"symbol": "AAPL", "spot_price": 189.42, "volume": 12340,
 *          "bid_ask_spread": 0.03, "volatility_1h": 0.018}
 * OUTPUT: {"symbol": "AAPL", "spot_price": 189.42,
 *          "fair_value": 190.10, "deviation_pct": -0.36}
 */

const DEVIATION_THRESHOLD = 0.5

broker market
    transport: kafka
    host: "kafka.trading.internal"
    port: 9092
end

model pricing_model
    source: env("PRICING_MODEL_PATH", "models/pricing_model.py")
    runtime: custom
    features: [msg.spot_price, msg.volume, msg.bid_ask_spread, msg.volatility_1h]
    returns: [fair_value, confidence]
end

pipeline signal_detector
    source from market :: "market/ticks"

    |> filter msg.spot_price > 0

    |> predict pricing_model

    |> sample 25%

    |> map {
        symbol        = msg.symbol;
        spot_price    = msg.spot_price;
        fair_value    = msg.fair_value;
        deviation_pct = (msg.spot_price - msg.fair_value) / msg.fair_value * 100
    }

    |> sink to market :: "signals/pricing"

    retry: 5 with backoff 200 ms
end
