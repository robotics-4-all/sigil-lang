// Example 14: Sink Format and Batching
//
// Demonstrates output configuration:
// - format: json | csv | raw — controls serialization
// - batch: { size: N, timeout: Ts } — buffers outbound messages
//   and flushes when either the count or timeout is reached
//
// Use case: high-throughput event processing that batches
// output to reduce BROKER publish overhead, using JSON format
// for structured downstream consumption.

BROKER ingest
    TRANSPORT: MQTT
    HOST: "localhost"
    PORT: 1883
;

BROKER warehouse
    TRANSPORT: REDIS
    HOST: "localhost"
    PORT: 6379
;

CONST BATCH_THRESHOLD = 200

PIPELINE event_batcher
    SOURCE FROM ingest :: "events/raw"

    |> DEDUPLICATE msg.event_id WITHIN 60 s

    |> FILTER msg.event_type is not null

    |> MAP {
        event = msg.event_type,
        payload = msg.data ?? "empty",
        ts = msg.timestamp
    }

    |> SINK TO warehouse :: "events.batched" FORMAT: json BATCH: { SIZE: 100 TIMEOUT: 10 s }
;

// A second PIPELINE demonstrating CSV format without batching
PIPELINE csv_exporter
    SOURCE FROM ingest :: "metrics/raw"

    |> FILTER msg.value is not null

    |> MAP {
        metric = msg.name,
        value = msg.value,
        unit = msg.unit ?? "unknown"
    }

    |> SINK TO warehouse :: "metrics.csv" FORMAT: csv
;

