/*
 * Example 09 — Constants and Environment Variables
 * ==================================================
 * Introduces `CONST` definitions and `env()` references for
 * portable, configurable pipelines.
 *
 * NEW FEATURES:
 *   CONST NAME = value     — compile-time named constant (inlined)
 *   env("KEY")             — read environment variable at runtime
 *   env("KEY", default)    — read with fallback value
 *
 * SCENARIO:
 *   An IoT temperature monitor that uses named thresholds and
 *   reads BROKER connection details from the environment.
 *   Constants are inlined at compile time; env() reads at runtime.
 *
 * INPUT:  {"sensor": "S-1", "temp_c": 85.3, "humidity": 62}
 * OUTPUT: {"celsius": 85.3, "above_threshold": true,
 *          "threshold_used": 80, "env_label": "production", ...}
 */

CONST TEMP_THRESHOLD = 80
CONST HUMIDITY_MIN = 30
CONST PIPELINE_LABEL = "temp_monitor"

BROKER iot
    HOST: "iot.example.com"
    PORT: 1883
;

PIPELINE temp_monitor
    SOURCE FROM iot :: "sensors/+/readings" QOS: 1 FORMAT: json

    // Filter: only process readings above minimum humidity
    // and with temperature above our named threshold
    |> FILTER msg.humidity >= HUMIDITY_MIN and msg.temp_c > TEMP_THRESHOLD

    |> WINDOW tumbling(1 m)

    |> AGGREGATE {
        avg_temp = avg(msg.temp_c),
        max_temp = max(msg.temp_c),
        readings = count()
    }

    |> MAP {
        avg_celsius = avg_temp,
        peak = max_temp,
        sample_count = readings,
        threshold_used = TEMP_THRESHOLD,
        // env() reads from the process environment at runtime
        deploy_env = env("DEPLOY_ENV", "development"),
        label = PIPELINE_LABEL
    }

    |> SINK TO iot :: "analytics/temperature"
;

