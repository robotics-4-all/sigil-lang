/*
 * Example 38 — Scalar Functions and Collection exists()
 * =======================================================
 * Demonstrates the built-in scalar functions and shows
 * `exists()` used over message array fields (collection form).
 *
 * SCALAR FUNCTIONS:
 *   abs(x)         — absolute value
 *   round(x, n)    — round to n decimal places
 *   floor(x)       — floor (round down to nearest integer)
 *   ceil(x)        — ceiling (round up to nearest integer)
 *   len(s)         — string or array length
 *   lower(s)       — lowercase string
 *   upper(s)       — uppercase string
 *   fmt("pat",…)   — string interpolation (shown in example 20)
 *
 * COLLECTION exists():
 *   exists(x in msg.field => predicate)
 *       — true if ANY element x of msg.field satisfies predicate
 *       — msg.field must be an array in the incoming message
 *       — compare with forall() which requires ALL elements to match
 *
 * SCENARIO:
 *   A content moderation pipeline for user-generated product reviews.
 *   Each message carries:
 *     - A numeric rating (1-5)
 *     - A list of string tags attached by the review system
 *     - A raw text excerpt
 *
 *   The pipeline:
 *     1. Drops messages missing required fields or out-of-range rating
 *     2. Uses `exists()` to flag reviews with a blocked tag
 *     3. Uses scalar funcs to normalise text fields and compute metrics
 *     4. Routes flagged reviews to a moderation queue; others to publish
 *
 * INPUT:  {"review_id": "R-881", "rating": 2,
 *           "tags": ["verified", "returns", "spam"],
 *           "excerpt": "  Terrible product!! "}
 * OUTPUT (flagged):   {"id": "R-881", "rating": 2, "tag_count": 3,
 *                       "clean_excerpt": "terrible product!!", "flagged": true}
 * OUTPUT (published): {"id": "R-881", "rating": 4, "tag_count": 2,
 *                       "clean_excerpt": "great quality.", "flagged": false}
 */

const BLOCKED_TAG  = "spam"
const MIN_EXCERPT  = 5
const MAX_EXCERPT  = 500

broker reviews
    transport: mqtt
    host: "reviews.example.com"
    port: 1883
end

broker moderation
    transport: amqp
    host: "rabbit.example.com"
    port: 5672
end

pipeline review_moderation
    source from reviews :: "reviews/submitted" format: json

    // Drop incomplete or invalid reviews
    |> filter msg.review_id is not null and
              msg.rating >= 1 and msg.rating <= 5 and
              msg.excerpt is not null

    |> map {
        // Scalar string functions: trim via lower/upper isn't exact but
        // lower() + len() demonstrate the built-in set clearly.
        let clean   = lower(msg.excerpt);
        let ex_len  = len(msg.excerpt);
        let n_tags  = len(msg.tags);

        // exists() — check if any tag in the array equals the blocked value
        let has_blocked = exists(t in msg.tags => t == BLOCKED_TAG);

        // round() and abs() — normalise rating deviation from midpoint
        let deviation   = round(abs(msg.rating - 3.0), 2);

        // floor/ceil to produce integer bounds of the normalised score
        let score_floor = floor(msg.rating / 5.0 * 100.0);
        let score_ceil  = ceil(msg.rating  / 5.0 * 100.0);

        id            = msg.review_id;
        rating        = msg.rating;
        tag_count     = n_tags;
        excerpt_len   = ex_len;
        clean_excerpt = clean;
        deviation     = deviation;
        score_pct_lo  = score_floor;
        score_pct_hi  = score_ceil;
        flagged       = has_blocked
    }

    // Route: flagged reviews go to moderation; clean reviews go to publish
    |> route
        when msg.flagged == true => sink to moderation :: "reviews.flagged"
        default                  => sink to reviews :: "reviews/published"
    end
end
