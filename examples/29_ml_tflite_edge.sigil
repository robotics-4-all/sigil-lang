/*
 * Example 29 — Edge ML Inference with TensorFlow Lite
 * ====================================================
 * Runs a lightweight TFLite MODEL on an edge gateway for
 * real-time predictive maintenance of industrial pumps.
 *
 * RUNTIME: tflite — uses tflite-runtime for minimal footprint
 *          on constrained devices (RPi, Jetson Nano, etc.).
 *
 * SCENARIO:
 *   Vibration and temperature sensors on industrial pumps publish
 *   readings at 1 Hz.  A quantized TFLite MODEL predicts remaining
 *   useful life (RUL) and failure probability locally on the edge
 *   gateway.  Only readings with elevated failure risk are forwarded
 *   to the cloud, saving bandwidth.
 *
 * INPUT:  {"pump_id": "PUMP-07", "vibration_x": 0.42, "vibration_y": 0.38,
 *          "vibration_z": 0.55, "bearing_temp": 72.1, "flow_rate": 14.8}
 * OUTPUT: {"pump_id": "PUMP-07", "failure_prob": 0.73, "rul_hours": 48.2,
 *          "bearing_temp": 72.1}
 */

BROKER edge_gateway
    HOST: "localhost"
    PORT: 1883
;

BROKER cloud_hub
    HOST: "iot.cloud-provider.com"
    PORT: 8883
    SSL: true
    AUTH: {
        USERNAME: "edge-gw-07"
        PASSWORD: "gw-auth-token"
    }
;

MODEL pump_health
    SOURCE: "models/pump_rul_quantized.tflite"
    RUNTIME: TFLITE
    FEATURES: [msg.vibration_x, msg.vibration_y, msg.vibration_z,
               msg.bearing_temp, msg.flow_rate]
    RETURNS: [failure_prob, rul_hours]
;

PIPELINE predictive_maintenance
    SOURCE FROM edge_gateway :: "pumps/+/sensors"

    |> DEDUPLICATE msg.pump_id WITHIN 2 s

    |> PREDICT pump_health

    |> FILTER msg.failure_prob > 0.5

    |> MAP {
        pump_id      = msg.pump_id,
        failure_prob = msg.failure_prob,
        rul_hours    = msg.rul_hours,
        bearing_temp = msg.bearing_temp
    }

    |> SINK TO cloud_hub :: "maintenance/alerts"

    ON_ERROR: DROP
;
