// Example 12: Quantifiers (forall / exists)
//
// Demonstrates two forms of quantifiers:
// 1. Collection-based: exists(x in msg.field => predicate)
//    Iterates over an array field in the current message.
// 2. Window-implicit: forall(m => predicate)
//    Iterates over all messages in the current WINDOW buffer.
//    Only valid in HAVING stage (requires WINDOW + AGGREGATE).
//
// Use case: IoT sensor monitoring PIPELINE that:
// - Filters messages to only those with at least one "alarm" tag
// - Groups by sensor, aggregates over 1-minute windows
// - Only emits if ALL readings in the WINDOW were positive

BROKER iot
    TRANSPORT: MQTT
    HOST: "localhost"
    PORT: 1883
;

CONST MIN_SAMPLES = 5

PIPELINE sensor_quality_check
    SOURCE FROM iot :: "sensors/+/readings"

    // Collection quantifier: only pass messages that have
    // at least one tag equal to "alarm"
    |> FILTER exists(t in msg.tags => t == "alarm")

    |> GROUP_BY msg.sensor_id

    |> WINDOW tumbling(1 m)

    |> AGGREGATE {
        n = count(),
        avg_reading = avg(msg.value),
        min_reading = min(msg.value)
    }

    // Window quantifier: only emit if ALL messages in the
    // WINDOW had a positive value AND there were enough samples
    |> HAVING forall(m => m > 0) and n >= MIN_SAMPLES

    |> MAP {
        sensor = msg.sensor_id,
        samples = n,
        average = avg_reading,
        minimum = min_reading
    }

    |> SINK TO iot :: "analytics/quality_reports"
;

