/*
 * Example 11 — Deduplication and Temporal Logic
 * ================================================
 * Introduces `deduplicate` for dropping duplicate messages and
 * `old()` / `changed()` for temporal state awareness.
 *
 * NEW FEATURES:
 *   deduplicate msg.field within 30s
 *       — drop messages with duplicate key values within a time window
 *       — must appear before filter (earliest stage position)
 *
 *   old(msg.field)
 *       — value of field from the PREVIOUS message
 *       — returns None if no previous message exists
 *
 *   changed(msg.field)
 *       — true if the field differs from its previous value
 *       — equivalent to: old(msg.field) != msg.field
 *
 * STAGE ORDER (with deduplicate):
 *   source → deduplicate → filter → ... → sink
 *
 * SCENARIO:
 *   An industrial sensor network where sensors may retransmit
 *   readings (duplicates by event_id). We want to:
 *   1. Drop duplicate events within a 60-second window
 *   2. Only forward readings where the status has changed
 *      OR the value has shifted significantly from the last reading
 *
 * INPUT:  {"event_id": "evt-001", "sensor": "S-5",
 *          "status": "normal", "value": 23.5}
 * OUTPUT: Only non-duplicate, status-changed or value-shifted messages
 */

broker factory
    host: "factory.local"
    port: 1883
end

pipeline sensor_dedup
    source from factory :: "sensors/+/events" qos: 1 format: json

    // Stage 1: Deduplicate — drop retransmits within 60 seconds
    |> deduplicate msg.event_id within 60s

    // Stage 2: Filter — only forward meaningful changes
    //   changed(msg.status) → status field differs from last message
    //   old(msg.value)      → previous message's value
    |> filter changed(msg.status) or msg.value > (old(msg.value) * 1.1)

    |> sink to factory :: "sensors/processed" qos: 1
end

