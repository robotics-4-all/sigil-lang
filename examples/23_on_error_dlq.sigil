// ─── Example 23: Error Handling & Dead Letter Queue ─────────────────
//
// ON_ERROR routes failed messages to a Dead Letter Queue (DLQ)
// instead of silently logging them. This enables:
//   - Post-mortem debugging of processing failures
//   - Automated retry systems consuming from the DLQ
//   - Error RATE monitoring via the DLQ topic
//
// Difficulty: Intermediate
// Features:  ON_ERROR SINK, ON_ERROR drop, DLQ routing

BROKER local
    HOST: "localhost"
    PORT: 1883
;

BROKER redis_broker
    TRANSPORT: REDIS
    HOST: "localhost"
    PORT: 6379
;

// ─── Basic DLQ routing ──────────────────────────────────────────────
// If any stage throws an exception, the original message plus error
// details are published to the DLQ topic as an envelope:
//   {
//     "_error": "division by zero",
//     "_error_type": "ZeroDivisionError",
//     "_pipeline": "sensor_pipeline",
//     "_timestamp": 1709123456.789,
//     "_original": { ... the original message ... }
//   }
PIPELINE sensor_pipeline
    SOURCE FROM local :: "sensors/raw"
    |> FILTER msg.value > 0
    |> WINDOW tumbling(1 m)
    |> AGGREGATE {
        avg_value: float = avg(msg.value),
        count = count()
    }
    |> MAP {
        average = avg_value,
        samples = count
    }
    |> SINK TO local :: "sensors/processed"
    ON_ERROR: SINK TO local :: "errors/sensors"
;

// ─── Cross-transport DLQ ────────────────────────────────────────────
// DLQ can use a different BROKER/transport than the main PIPELINE.
// Here: SOURCE from MQTT, DLQ to Redis for persistent error storage.
PIPELINE payment_processor
    SOURCE FROM local :: "payments/incoming"
    |> FILTER msg.amount > 0 and msg.currency != ""
    |> SINK TO local :: "payments/validated"
    ON_ERROR: SINK TO redis_broker :: "dlq:payments"
;

// ─── Explicit drop ──────────────────────────────────────────────────
// ON_ERROR: drop silently discards failed messages (logs at DEBUG).
// Use when you explicitly don't care about failures (e.g., best-effort
// telemetry that can tolerate data loss).
PIPELINE telemetry_best_effort
    SOURCE FROM local :: "telemetry/raw"
    |> FILTER msg.signal_strength > -90
    |> SINK TO local :: "telemetry/filtered"
    ON_ERROR: DROP
;

// ─── No ON_ERROR (default behavior) ────────────────────────────────
// Without ON_ERROR, failures are logged at ERROR level but the message
// is lost. This is the original behavior — shown here for comparison.
PIPELINE legacy_pipeline
    SOURCE FROM local :: "legacy/input"
    |> SINK TO local :: "legacy/output"
;
