// Example 16 — Conditional Routing
//
// Demonstrates fan-out routing based on message content.
// Instead of a single SINK, messages are routed to different
// topics/brokers based on conditions.
//
// Data flow:
//   sensors/all → [classify] → priority/high (if value > 90)
//                             → priority/medium (if value > 50)
//                             → priority/low (default)

BROKER local
    HOST: "localhost"
    PORT: 1883
;

BROKER alerts
    TRANSPORT: REDIS
    HOST: "redis.local"
    PORT: 6379
;

PIPELINE classify
    @INITIALLY { PUBLISH { status: "router_online" } }

    SOURCE FROM local :: "sensors/all"

    |> FILTER msg.value is not null

    |> ROUTE
        when msg.value > 90 => SINK TO alerts :: "priority.high"
        when msg.value > 50 => SINK TO local :: "priority/medium"
        DEFAULT => SINK TO local :: "priority/low"
    ;

    @FINALLY { PUBLISH { status: "router_offline" } }
;

