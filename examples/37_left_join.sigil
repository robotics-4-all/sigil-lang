/*
 * Example 37 — Left Join
 * ========================
 * Extends the JOIN concept from Example 22 with the `left` JOIN type.
 *
 * JOIN TYPES:
 *   type: inner  (default)
 *       — messages are only forwarded if a matching record is found on
 *         the right stream within the time WINDOW; unmatched are dropped
 *
 *   type: left
 *       — every primary message is forwarded regardless of whether a
 *         match is found; when no match exists, `other` is null in
 *         downstream stages
 *       — use `??` (null-coalesce) to provide safe defaults for
 *         fields that come from the right stream
 *
 * WHY LEFT JOIN:
 *   Use left JOIN when the primary stream must never be silently dropped.
 *   Common cases:
 *     - Enriching events with optional metadata (metadata may be absent)
 *     - Audit log pipelines that cannot afford to lose messages
 *     - Graceful degradation: publish with partial data rather than nothing
 *
 * SCENARIO:
 *   A helpdesk ticketing PIPELINE. Every support ticket (primary stream)
 *   is enriched with the assigned agent's profile (secondary stream).
 *   If no agent profile arrives within 10 seconds, the ticket is still
 *   forwarded — `other` fields are null-coalesced to safe defaults.
 *
 * INPUT (primary):   {"ticket_id": "T-501", "agent_id": "A-07",
 *                      "priority": "high", "category": "billing"}
 * INPUT (secondary): {"id": "A-07", "name": "Alice", "team": "finance"}
 *
 * OUTPUT (matched):   {"ticket": "T-501", "priority": "high",
 *                       "agent": "Alice", "team": "finance",
 *                       "enriched": true}
 * OUTPUT (unmatched): {"ticket": "T-501", "priority": "high",
 *                       "agent": "unassigned", "team": "unknown",
 *                       "enriched": false}
 */

BROKER helpdesk
    TRANSPORT: MQTT
    HOST: "helpdesk.example.com"
    PORT: 1883
;

PIPELINE enrich_tickets
    SOURCE FROM helpdesk :: "tickets/new" QOS: 1 FORMAT: json

    // Left JOIN: every ticket passes through even without an agent profile
    |> JOIN helpdesk :: "agents/profiles"
        ON msg.agent_id == other.id
        WITHIN 10 s
        TYPE: left
    ;

    // No FILTER here — left JOIN ensures we never drop tickets

    |> MAP {
        // `other` may be null when no agent profile arrived in time.
        // Use ?? to provide safe fallback values.
        LET agent_name = other.name ?? "unassigned",
        LET agent_team = other.team ?? "unknown",
        LET enriched   = if other.name is not null then true else false,

        ticket   = msg.ticket_id,
        priority = msg.priority ?? "normal",
        category = msg.category ?? "general",
        agent    = agent_name,
        team     = agent_team,
        enriched = enriched
    }

    |> ROUTE
        when msg.priority == "critical" => SINK TO helpdesk :: "tickets/critical"
        when msg.priority == "high"     => SINK TO helpdesk :: "tickets/high"
        DEFAULT                         => SINK TO helpdesk :: "tickets/normal"
    ;
;
