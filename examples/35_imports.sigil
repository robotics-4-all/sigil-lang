/*
 * Example 35 — Multi-File Imports
 * =================================
 * Demonstrates `import` declarations that merge constants, schemas,
 * and pipelines from external .sigil files into the current model.
 *
 * NEW FEATURES:
 *   import "path/to/file.sigil"
 *       — path is relative to the importing file's directory
 *       — merges all top-level declarations from the target file:
 *           brokers, constants, schemas, functions, pipelines
 *       — circular imports are detected and rejected
 *       — multiple imports in a single file are allowed
 *       — imported names are available throughout the importing file
 *         exactly as if they were declared inline
 *
 * IMPORT RESOLUTION SEMANTICS:
 *   Brokers that are cross-referenced (e.g. `source from BROKER`) must
 *   be defined in the same file as the pipeline using them — textX
 *   resolves cross-references at parse time, before import merging.
 *   Brokers imported from another file are available for reference ONLY
 *   by pipelines defined in THAT imported file itself.
 *
 *   Constants, schemas, and functions defined in imported files ARE
 *   available for use in the importing file's pipelines and expressions.
 *
 * WHY USE IMPORTS:
 *   - Keep threshold constants in one place, update once across files
 *   - Reuse schema declarations without copy-paste
 *   - Share utility functions across multiple pipeline files
 *   - Include pre-built pipelines from a shared library
 *
 * FILE LAYOUT:
 *   examples/
 *     35_imports.sigil          ← this file (brokers defined here)
 *     shared/
 *       constants.sigil         ← TEMP_MIN, ALERT_TEMP, WINDOW_MIN, etc.
 *       schemas.sigil           ← SensorReading, AlertPayload schemas
 *
 * SCENARIO:
 *   A factory floor monitoring system. Thresholds and schema definitions
 *   live in shared files (imported here). Brokers are declared locally
 *   because they are referenced as cross-references in source/sink.
 *
 * INPUT:  {"device_id": "S-12", "value": 87.5, "unit": "celsius",
 *           "ts": 1711234567, "tags": ["furnace", "zone-A"]}
 * OUTPUT (alerts):  {"device": "S-12", "temp": 87.5, "severity": "high"}
 * OUTPUT (summary): {"device": "S-12", "avg_temp": 83.2, "readings": 30}
 */

// Import shared constants and schemas.
// Constants and schema names defined in these files are available
// throughout this file's pipelines just as if declared here.
import "shared/constants.sigil"
import "shared/schemas.sigil"

// Brokers must be defined here (not in an imported file) when they are
// referenced in source/sink cross-references by pipelines in this file.
broker edge
    transport: mqtt
    host: "10.0.1.1"
    port: 1883
end

broker analytics
    transport: redis
    host: "redis.internal"
    port: 6379
end

// Local function (could also be shared via a func-only import file)
func celsius_to_fahrenheit(c) = c * 9.0 / 5.0 + 32.0

// ── Pipeline 1: Immediate alerts for high-temperature readings ──────────────
pipeline temp_alerts
    // Constants ALERT_TEMP and TEMP_MAX come from shared/constants.sigil.
    // Schema cross-references (schema: SensorReading) must reference schemas
    // defined in the SAME file; imported schemas cannot be cross-referenced
    // at parse time (see shared/schemas.sigil for the definitions).
    source from edge :: "factory/+/temperature" qos: 1 format: json

    |> filter msg.value > ALERT_TEMP and msg.value <= TEMP_MAX

    |> map {
        // celsius_to_fahrenheit() is a local func defined above
        let fahrenheit = celsius_to_fahrenheit(msg.value);
        let severity   = if msg.value > 100 then "critical" else "high";

        device   = msg.device_id;
        temp_c   = msg.value;
        temp_f   = fahrenheit;
        severity = severity;
        ts       = msg.ts
    }

    |> sink to edge :: "factory/alerts/temperature" qos: 1
end

// ── Pipeline 2: Per-device 5-minute temperature summary ────────────────────
pipeline device_summary
    source from edge :: "factory/+/temperature" qos: 1 format: json

    // Filter using imported constants — valid physical range only
    |> filter msg.value >= TEMP_MIN and msg.value <= TEMP_MAX

    |> group_by msg.device_id

    // WINDOW_MIN is imported from shared/constants.sigil (value: 5)
    |> window tumbling(5 m)

    |> aggregate {
        avg_temp = avg(msg.value)
        max_temp = max(msg.value)
        readings = count()
    }

    |> having readings >= 5

    |> map {
        device   = msg.device_id;
        avg_temp = avg_temp;
        peak     = max_temp;
        n        = readings
    }

    |> sink to analytics :: "factory:device:summary"
end
