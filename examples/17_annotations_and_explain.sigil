// Example 17 — Stage Annotations & Explain
//
// Demonstrates compile-time @warn/@error annotations on stages.
// These annotations are emitted during `sigil check` — they
// have no runtime effect on generated code.
//
// Try: sigil explain examples/17_annotations_and_explain.sigil
// Try: sigil check examples/17_annotations_and_explain.sigil

CONST TEMP_LIMIT = 120

BROKER local
    HOST: "localhost"
    PORT: 1883
;

PIPELINE monitored
    SOURCE FROM local :: "sensors/temperature"

    // @warn annotations emit warnings during validation
    |> @WARN("large window may cause memory pressure") WINDOW tumbling(1 h)

    |> AGGREGATE {
        avg_temp = avg(msg.value),
        max_temp = max(msg.value),
        n = count()
    }

    |> @WARN("having with > 100 threshold may filter most windows") HAVING n > 100

    |> MAP {
        LET severity = case {
            when max_temp > TEMP_LIMIT => "critical"
            when max_temp > 80 => "warning"
            else => "normal"
        },
        average = avg_temp,
        peak = max_temp,
        level = severity,
        samples = n
    }

    |> SINK TO local :: "analytics/temperature"
;

