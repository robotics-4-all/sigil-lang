/*
 * Example 06 — Map Transform
 * ============================
 * Reshape and rename aggregated fields before publishing.
 *
 * CONCEPTS INTRODUCED:
 *   - MAP stage         — transform the output with expressions
 *   - Field references  — in MAP, bare names refer to aggregation results
 *   - Arithmetic        — compute derived values from aggregates
 *
 * WHAT IT DOES:
 *   Collects energy meter readings, aggregates kWh over 1 hour,
 *   then renames fields and computes a cost estimate before publishing.
 *
 * MAP EXPRESSION CONTEXT:
 *   Inside a MAP stage, field references work differently:
 *     bare_name      → reads from aggregation results (e.g., total_kwh)
 *     msg.field      → reads from the original message
 *
 *   You can use arithmetic to compute derived values:
 *     cost = total_kwh * 0.12    → multiply AGGREGATE by price per kWh
 *
 *   Separate multiple assignments with semicolons (;).
 *
 * WITHOUT MAP:  {"total_kwh": 45.2, "peak_kw": 3.1, "readings": 360}
 * WITH MAP:     {"energy": 45.2, "peak_demand": 3.1, "cost_eur": 5.424, "samples": 360}
 */

BROKER meters
    HOST: "localhost"
    PORT: 1883
;

PIPELINE energy_report
    SOURCE FROM meters :: "meters/+/energy" FORMAT: json

    |> WINDOW tumbling(1 h)

    |> AGGREGATE {
        total_kwh = sum(msg.kwh), // total energy consumed
        peak_kw   = max(msg.kw), // peak demand
        readings  = count()            // number of meter readings
    }

    /*
     * Rename fields and compute derived values.
     * Inside a MAP, bare names refer to aggregation outputs.
     * You can use arithmetic to derive new values.
     */
    |> MAP {
        energy      = total_kwh,
        peak_demand = peak_kw,
        cost_eur    = total_kwh * 0.12,
        samples     = readings
    }

    |> SINK TO meters :: "reports/energy/hourly"
;

