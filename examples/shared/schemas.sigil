/*
 * shared/schemas.sigil — Shared schema declarations
 *
 * Imported by examples/35_imports.sigil.
 * Schemas defined here are merged into the importing model and can
 * be referenced in `source … schema: NAME` clauses.
 */

SCHEMA SensorReading STRICT
    device_id : str
    value     : float
    unit      : str
    ts        : int
    tags      : [str]?
;

SCHEMA AlertPayload LENIENT
    device_id : str
    value     : float
    threshold : float
    severity  : str
;
