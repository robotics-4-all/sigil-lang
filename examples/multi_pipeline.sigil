broker edge
    transport: mqtt
    host: "192.168.1.100"
    port: 1883
    auth: {
        username: "admin"
        password: "s3cret"
    }
end

broker cloud
    transport: redis
    host: "redis.example.io"
    port: 6379
    ssl: true
    auth: {
        username: "device01"
        password: "tok3n"
    }
end

pipeline temperature_monitor
    source from edge :: "factory/+/temperature" qos: 1 format: json

    |> filter: msg.value > -40 and msg.value < 150

    |> group_by: msg.zone

    |> window: tumbling(1 m)

    |> aggregate: {
        avg_temp = avg(msg.value)
        max_temp = max(msg.value)
        min_temp = min(msg.value)
        readings = count()
    }

    |> map: {
        temperature_avg = avg_temp;
        temperature_max = max_temp;
        temperature_min = min_temp;
        sample_count    = readings
    }

    |> sink to cloud :: "analytics/temperature" qos: 1
end

pipeline vibration_alert
    source from edge :: "factory/+/vibration" qos: 2 format: json

    |> filter: msg.rms > 10.0

    |> window: sliding(30 s, step = 5 s)

    |> aggregate: {
        peak_rms   = max(msg.rms)
        avg_rms    = avg(msg.rms)
        deviation  = stddev(msg.rms)
        num_events = count()
    }

    |> sink to cloud :: "alerts/vibration" qos: 2
end

