/*
 * Example 04 — Sliding Window
 * =============================
 * Overlapping windows that slide forward by a step interval.
 *
 * CONCEPTS INTRODUCED:
 *   - WINDOW sliding(size, step = interval)
 *   - stddev() — standard deviation aggregation
 *   - Millisecond durations (ms)
 *
 * WHAT IT DOES:
 *   Monitors machine vibration data. Uses a 10-second WINDOW that slides
 *   every 2 seconds, producing an output every 2s with stats from the
 *   last 10 seconds of data. This smooths out noise while detecting trends.
 *
 * VISUALIZATION:
 *   Time:  0    2    4    6    8    10   12   14
 *          |=========== WINDOW 1 ===========|
 *               |=========== WINDOW 2 ===========|
 *                    |=========== WINDOW 3 ===========|
 *   Output:              ^         ^         ^
 *                     (at t=10)  (at t=12)  (at t=14)
 *
 * NOTE: The step must be smaller than the WINDOW size.
 *       step > size would create gaps (and is a validation error).
 */

BROKER local
    HOST: "localhost"
    PORT: 1883
;

PIPELINE vibration_monitor
    SOURCE FROM local :: "machines/+/vibration" QOS: 2 FORMAT: json

    // 10-second WINDOW, sliding every 2 seconds
    |> WINDOW sliding(10 s, STEP = 2 s)

    |> AGGREGATE {
        avg_rms    = avg(msg.rms), // mean vibration level
        peak_rms   = max(msg.rms), // peak vibration
        deviation  = stddev(msg.rms), // variability (spikes vs steady)
        samples    = count()           // data points in this WINDOW
    }

    |> SINK TO local :: "analytics/vibration" QOS: 1
;

