/*
 * Example 27 — ML Classification with scikit-learn
 * ==================================================
 * Uses a pre-trained scikit-learn classifier to categorize
 * incoming support tickets by urgency level.
 *
 * RUNTIME: sklearn — loads a joblib-serialized MODEL.
 *
 * SCENARIO:
 *   Customer support tickets arrive as structured messages.
 *   An sklearn MODEL classifies each ticket as low/medium/high
 *   urgency based on word count, response time, and sentiment.
 *   Results are routed to priority-specific queues.
 *
 * INPUT:  {"ticket_id": "TK-991", "word_count": 320, "response_hours": 0.5,
 *          "sentiment_score": -0.7, "category": "billing"}
 * OUTPUT: {"ticket_id": "TK-991", "urgency": 2, "category": "billing"}
 *         (routed to "tickets/high" because urgency >= 2)
 */

BROKER support
    TRANSPORT: AMQP
    HOST: "rabbitmq.internal"
    PORT: 5672
    AUTH: {
        USERNAME: "ticket-svc"
        PASSWORD: "amqp-token"
    }
;

MODEL urgency_classifier
    SOURCE: "models/urgency_clf.pkl"
    RUNTIME: SKLEARN
    FEATURES: [msg.word_count, msg.response_hours, msg.sentiment_score]
    RETURNS: [urgency]
;

PIPELINE ticket_triage
    SOURCE FROM support :: "tickets/incoming"

    |> FILTER msg.word_count is not null

    |> PREDICT urgency_classifier

    |> ROUTE
        when msg.urgency >= 2 => SINK TO support :: "tickets/high"
        when msg.urgency >= 1 => SINK TO support :: "tickets/medium"
        DEFAULT               => SINK TO support :: "tickets/low"
    ;
;
