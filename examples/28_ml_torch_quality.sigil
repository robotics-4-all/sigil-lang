/*
 * Example 28 — ML Quality Inspection with PyTorch
 * =================================================
 * Uses a TorchScript MODEL for real-time quality scoring on a
 * manufacturing production line.
 *
 * RUNTIME: torch — loads a TorchScript MODEL via torch.jit.load.
 *
 * SCENARIO:
 *   Vision sensors on a conveyor belt extract numeric features
 *   from product images (edge-computed upstream).  A PyTorch MODEL
 *   predicts a quality score and defect probability.  Products
 *   scoring below threshold are diverted for manual inspection.
 *   Windowed statistics track line quality over 10-minute periods.
 *
 * INPUT:  {"product_id": "P-8842", "line": "A3",
 *          "brightness": 0.82, "symmetry": 0.95,
 *          "edge_sharpness": 0.71, "color_deviation": 0.04}
 * OUTPUT: {"line": "A3", "avg_quality": 0.87, "defect_rate": 0.03,
 *          "inspected": 412}
 */

BROKER factory
    TRANSPORT: REDIS
    HOST: "10.0.1.50"
    PORT: 6379
;

MODEL quality_model
    SOURCE: env("QUALITY_MODEL_PATH", "models/quality_inspector.pt")
    RUNTIME: TORCH
    FEATURES: [msg.brightness, msg.symmetry, msg.edge_sharpness, msg.color_deviation]
    RETURNS: [quality_score, defect_prob]
;

PIPELINE quality_monitor
    SOURCE FROM factory :: "line/+/features"

    |> PREDICT quality_model

    |> GROUP_BY msg.line

    |> WINDOW tumbling(10 m)

    |> AGGREGATE {
        avg_quality = avg(msg.quality_score),
        max_defect  = max(msg.defect_prob),
        defect_rate = avg(msg.defect_prob),
        inspected   = count()
    }

    |> MAP {
        avg_quality  = avg_quality,
        defect_rate  = defect_rate,
        max_defect   = max_defect,
        inspected    = inspected
    }

    |> SINK TO factory :: "analytics/quality/summary"
;
