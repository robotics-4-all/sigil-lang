            ]

            for _jt, _jmsg in self._join_buffer:
                _right_key = _get_nested(_jmsg, {{ p.join.right_key_code }})
                if _left_key == _right_key:
                    other = _jmsg
                    _matched = True
                    break

            if not _matched:
{% if p.join.join_type == "left" %}
                other = None
{% else %}
                self._join_pending.append((_now, msg))
                return
{% endif %}
{% endif %}

{% if p.has_filter %}
