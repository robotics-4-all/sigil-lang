    def _on_message(self, msg):
        if not isinstance(msg, dict):
            try:
                msg = json.loads(msg) if isinstance(msg, (str, bytes)) else msg
            except (json.JSONDecodeError, TypeError, ValueError) as exc:
                logger.warning("Invalid message (not JSON dict): %s", exc)
                return
            if not isinstance(msg, dict):
                logger.warning("Invalid message type: %s", type(msg).__name__)
                return
{% if p.has_pipeline_lets %}
{% for plb in p.pipeline_lets %}
        {{ plb.name }} = {{ plb.value_code }}
{% endfor %}
{% endif %}
{% if p.has_dedup %}
        _dedup_key = str(_get_nested(msg, {{ p.dedup_key_code }}))
        _now = time.time()
        if _dedup_key in self._dedup_seen:
            if _now - self._dedup_seen[_dedup_key] < self._dedup_ttl:
                return
        self._dedup_seen[_dedup_key] = _now
        self._dedup_seen = {
            k: v for k, v in self._dedup_seen.items()
            if _now - v < self._dedup_ttl
        }
{% endif %}

{% if p.has_rate %}
        with self._rate_lock:
            _now_rate = time.time()
            _elapsed = _now_rate - self._rate_last_refill
            self._rate_tokens = min(
                float(self._rate_limit),
                self._rate_tokens + _elapsed * (self._rate_limit / self._rate_period),
            )
            self._rate_last_refill = _now_rate
            if self._rate_tokens < 1.0:
{% if p.rate_on_excess == "warn" %}
                logger.warning("Rate limit exceeded, message dropped")
{% elif p.rate_on_excess == "error" %}
                logger.error("Rate limit exceeded, message dropped")
{% endif %}
                return
            self._rate_tokens -= 1.0
{% endif %}

{% if p.has_sample %}
        if random.randint(1, 100) > {{ p.sample_percentage }}:
            return
{% endif %}

{% if p.has_throttle %}
        with self._throttle_lock:
            _now_throttle = time.time()
            _elapsed = _now_throttle - self._throttle_last_refill
            self._throttle_tokens = min(
                float(self._throttle_limit),
                self._throttle_tokens + _elapsed * (self._throttle_limit / self._throttle_period),
            )
            self._throttle_last_refill = _now_throttle
            if self._throttle_tokens < 1.0:
{% if p.throttle_overflow == "buffer" %}
                if len(self._throttle_buffer) < self._throttle_buffer_size:
                    self._throttle_buffer.append(msg)
                else:
                    logger.warning("Throttle buffer full, message dropped")
{% else %}
                logger.debug("Throttle limit exceeded, message dropped")
{% endif %}
                return
            self._throttle_tokens -= 1.0
{% endif %}

{% if p.has_flatten %}
        _items = _get_nested(msg, {{ p.flatten_key_code }})
        if isinstance(_items, list):
            for _item in _items:
                self._process_flattened(_item)
        else:
            self._process_flattened(msg)
        return

    def _process_flattened(self, msg):
{% endif %}

{% if p.has_distinct %}
        _distinct_key = str(_get_nested(msg, {{ p.distinct_key_code }}))
        _now = time.time()
        if _distinct_key in self._distinct_seen:
            if _now - self._distinct_seen[_distinct_key] < self._distinct_ttl:
                return
        self._distinct_seen[_distinct_key] = _now
        self._distinct_seen = {
