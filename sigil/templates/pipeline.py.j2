{% if p.has_throttle and p.throttle_overflow == "buffer" %}
    def _schedule_throttle_drain(self):
        if self._throttle_drain_thread and self._throttle_drain_thread.is_alive():
            return
        self._throttle_drain_event.clear()
        self._throttle_drain_thread = threading.Thread(
            target=self._throttle_drain_loop, daemon=True
        )
        self._throttle_drain_thread.start()

    def _throttle_drain_loop(self):
        interval = self._throttle_period / max(self._throttle_limit, 1)
        while not self._throttle_drain_event.wait(timeout=interval):
            if not self._running:
                break
            _buffered_msg = None
            with self._throttle_lock:
                if not self._throttle_buffer:
                    continue
                _now = time.time()
                _elapsed = _now - self._throttle_last_refill
                self._throttle_tokens = min(
                    float(self._throttle_limit),
                    self._throttle_tokens + _elapsed * (self._throttle_limit / self._throttle_period),
                )
                self._throttle_last_refill = _now
                if self._throttle_tokens >= 1.0:
                    _buffered_msg = self._throttle_buffer.pop(0)
                    self._throttle_tokens -= 1.0
            if _buffered_msg is not None:
                self._on_message(_buffered_msg)
{% endif %}

    def _publish_with_retry(self, publisher, payload):
        """Publish with exponential backoff retry."""
        for attempt in range(_MAX_PUBLISH_RETRIES):
            try:
                publisher.publish(payload)
                return
            except Exception as exc:
                if attempt < _MAX_PUBLISH_RETRIES - 1:
                    delay = _PUBLISH_RETRY_BASE * (2 ** attempt) + random.uniform(0, 0.05)
                    logger.warning(
                        "Publish failed (attempt %d/%d): %s — retrying in %.2fs",
                        attempt + 1, _MAX_PUBLISH_RETRIES, exc, delay,
                    )
                    time.sleep(delay)
                else:
                    logger.error(
                        "Publish failed after %d attempts: %s", _MAX_PUBLISH_RETRIES, exc,
                    )

    def _notify_downstream(self, msg):
        for listener in self._downstream_listeners:
            listener(msg)

{% if p.has_on_error and not p.on_error_drop %}
    def _publish_to_dlq(self, error, original_data):
        """Route failed messages to the dead-letter queue."""
        try:
            envelope = {
                "_error": str(error),
                "_error_type": type(error).__name__,
                "_pipeline": self.name,
                "_timestamp": time.time(),
                "_original": original_data,
            }
            self._publish_with_retry(self._dlq_publisher, envelope)
            logger.warning("Message sent to DLQ: %s", error)
        except Exception as dlq_exc:
            logger.error("Failed to publish to DLQ: %s (original error: %s)", dlq_exc, error)
{% endif %}

