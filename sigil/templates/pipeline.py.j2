            self._window_thread_{{ w.name }}.join(timeout=timeout)
{% endfor %}
{% endif %}
{% if p.has_batch and p.batch_timeout_seconds is not none %}
        self._batch_stop_event.set()
        if self._batch_thread:
            self._batch_thread.join(timeout=timeout)
{% endif %}
{% if p.has_throttle and p.throttle_overflow == "buffer" %}
        self._throttle_drain_event.set()
        if self._throttle_drain_thread:
            self._throttle_drain_thread.join(timeout=timeout)
