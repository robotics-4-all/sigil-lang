    def _on_join_message(self, msg):
        _now = time.time()
        with self._join_lock:
            self._join_buffer.append((_now, msg))
            self._join_buffer = [
                (t, m) for t, m in self._join_buffer
                if _now - t < self._join_window
            ]

            pending_retry = list(self._join_pending)
            self._join_pending.clear()

        for _pt, _pmsg in pending_retry:
            if _now - _pt < self._join_window:
                self._on_message(_pmsg)
