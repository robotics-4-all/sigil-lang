/*
 * Sigil — Stream Processing Pipeline DSL
 *
 * EBNF-style grammar (textX notation).
 * Grammar IS the metamodel — each rule defines both syntax and the AST class.
 *
 * Syntax highlights:
 *   - Structural blocks (BROKER, PIPELINE, ROUTE, JOIN, ENRICH, MODEL, SCHEMA)
 *     terminate with `;`
 *   - Brace-delimited blocks (AGGREGATE, ACCUMULATE, MAP, AUTH, BATCH,
 *     ObjectLiteral, hooks) keep `{}` and do NOT use `;`
 *   - Stages are chained with `|>` pipe operator
 *   - Source: `SOURCE FROM <broker> :: "<topic>"` or `SOURCE FROM PIPE <name>`
 *   - Sink: `SINK TO <broker> :: "<topic>"`
 *
 * Precedence (low → high):
 *   or  →  and  →  comparison  →  +,-  →  *,/,%  →  ??  →  unary(-,not)  →  atom
 *
 * Reserved keywords (cannot be used as identifiers):
 *   STRUCTURAL (UPPERCASE):
 *     PIPELINE, BROKER, SOURCE, SINK, FILTER, WINDOW, AGGREGATE, ACCUMULATE,
 *     MAP, HAVING, DEDUPLICATE, FLATTEN, DISTINCT, THROTTLE, SAMPLE,
 *     GROUP_BY, RATE, PREDICT, DEBUG, VALIDATE, ENRICH, JOIN, ROUTE,
 *     CONST, FUNC, MODEL, SCHEMA, IMPORT, LET, SELECT, BATCH, RETRY,
 *     WITH, BACKOFF, ON_ERROR, INITIALLY, FINALLY, PUBLISH, OVER, STEP,
 *     QOS, FORMAT, SSL, AUTH, USERNAME, PASSWORD, HOST, PORT, TRANSPORT,
 *     SIZE, TIMEOUT, FROM, TO, PIPE, ON, TYPE, VIA, HTTP, URL,
 *     METHOD, BIND, GET, POST, PUT, FEATURES, RETURNS, RUNTIME, STRICT,
 *     LENIENT, WITHIN, PER, ON_EXCESS, OVERFLOW, BUFFER, WARN, ERROR,
 *     DROP, DEFAULT, SKIP, ROUTE, DEBUG, LABEL, FIELDS, SCHEMA,
 *     ONNX, SKLEARN, TORCH, TFLITE, CUSTOM,
 *     MQTT, REDIS, AMQP, KAFKA
 *
 *   EXPRESSION (lowercase):
 *     and, or, is, not, null, if, then, else, case, when, match,
 *     forall, exists, old, changed, env, fmt, in
 *
 *   FUNCTIONS (lowercase):
 *     avg, sum, min, max, count, stddev, first, last, percentile, distinct_count,
 *     ema, cumsum, delta,
 *     abs, round, len, lower, upper, floor, ceil, fmt, trim, contains,
 *     starts_with, ends_with, split, replace, substring, sqrt, pow, log, log10, exp,
 *     to_int, to_float, to_str, to_bool, now, timestamp_ms, date_format, date_diff,
 *     matches, extract
 *
 *   TYPES (lowercase):
 *     int, float, str, bool
 *
 *   VALUES (lowercase):
 *     tumbling, sliding, inner, left, json, csv, raw
 */

Model:
    (imports+=ImportDecl | brokers+=Broker | pipelines+=Pipeline | constants+=ConstDef | schemas+=SchemaDef | functions+=FuncDef | models+=ModelDef)*
;

// ─── Imports ────────────────────────────────────────────────────────
ImportDecl:
    'IMPORT' path=STRING
;

// ─── Constants ──────────────────────────────────────────────────────
ConstDef:
    'CONST' name=ID '=' value=ConstValue
;

ConstValue:
    FloatLiteral | IntLiteral | StringLiteral | BoolLiteral
;

// ─── User-defined functions ────────────────────────────────────────
FuncDef:
    'FUNC' name=ID '(' (params+=ID[','])? ')' '=' body=Expression
;

// ─── Broker connection ──────────────────────────────────────────────
Broker:
    'BROKER' name=ID
        ('TRANSPORT' ':' transport=Transport)?
        'HOST'  ':' host=STRING
        'PORT'  ':' port=INT
        ('SSL'  ':' ssl=BOOL)?
        ('AUTH' ':' '{'
            'USERNAME' ':' username=STRING
            'PASSWORD' ':' password=STRING
        '}')?
    ';'
;

Transport:
    'MQTT' | 'REDIS' | 'AMQP' | 'KAFKA'
;

// ─── Pipeline ───────────────────────────────────────────────────────
Pipeline:
    'PIPELINE' name=ID
        (initially=InitiallyHook)?
        source=Source
        ('|>' join=JoinStage)?
        (pipeline_lets+=PipelineLetBinding)*
        ('|>' stages+=AnnotatedStage)*
        ('|>' (sink=Sink | route=RouteBlock))?
        (on_error=OnErrorClause)?
        (retry=RetryPolicy)?
        (finally_=FinallyHook)?
    ';'
;

PipelineLetBinding:
    'LET' name=ID '=' value=Expression
;

// ─── Stage annotations ─────────────────────────────────────────────
AnnotatedStage:
    (annotations+=StageAnnotation)* stage=Stage
;

StageAnnotation:
    '@' severity=AnnotationSeverity '(' message=STRING ')'
;

AnnotationSeverity:
    'WARN' | 'ERROR'
;

// ─── Conditional routing ────────────────────────────────────────────
RouteBlock:
    'ROUTE' ('VIA' via_broker=[Broker])?
        arms+=RouteArm
        ('DEFAULT' '=>' (default_sink=RouteSink | default_topic=STRING))?
    ';'
;

RouteArm:
    'when' condition=Expression '=>' (sink=RouteSink | topic=STRING)
;

RouteSink:
    'SINK' 'TO' broker=[Broker] '::' topic=STRING
    ('QOS' ':' qos=INT)?
;

// ─── Join (second stream) ───────────────────────────────────────────
JoinStage:
    'JOIN' broker=[Broker] '::' topic=STRING
        'ON' left_key=FieldRef '==' right_key=FieldRef
        'WITHIN' window=Duration
        ('TYPE' ':' type=JoinType)?
    ';'
;

JoinType:
    'inner' | 'left'
;

// ─── Lifecycle hooks ────────────────────────────────────────────────
InitiallyHook:
    '@INITIALLY' '{' 'PUBLISH' body=ObjectLiteral '}'
;

FinallyHook:
    '@FINALLY' '{' 'PUBLISH' body=ObjectLiteral '}'
;

ObjectLiteral:
    '{' fields+=ObjectField[','] '}'
;

ObjectField:
    name=ID ':' value=Expression
;


// ─── On-error / DLQ routing ─────────────────────────────────────────
OnErrorClause:
    'ON_ERROR' ':' (
        'DROP'
    |
        'SINK' 'TO' broker=[Broker] '::' topic=STRING
    )
;

// ─── Retry policy ───────────────────────────────────────────────────
RetryPolicy:
    'RETRY' ':' max_retries=INT 'WITH' 'BACKOFF' base=Duration
;

// ─── Source / Sink ──────────────────────────────────────────────────
Source:
    'SOURCE' 'FROM'
    (
        'PIPE' pipe=ID
    |
        broker=[Broker] '::' topic=STRING
        ('QOS' ':' qos=INT)?
        ('FORMAT' ':' format=Format)?
        ('SCHEMA' ':' schema=[SchemaDef])?
    )
;

Format:
    'json' | 'csv' | 'raw'
;

Sink:
    'SINK' 'TO' broker=[Broker] '::' topic=STRING
    ('QOS' ':' qos=INT)?
    ('FORMAT' ':' format=Format)?
    ('BATCH' ':' '{' batch=BatchConfig '}')?
;

BatchConfig:
    ('SIZE' ':' size=INT)?
    ('TIMEOUT' ':' timeout=Duration)?
;

// ─── Pipeline stages (abstract) ────────────────────────────────────
Stage:
    DeduplicateStage | FilterStage | ValidateStage | PredictStage | RateStage | FlattenStage
    | DistinctStage | ThrottleStage | SampleStage | GroupByStage | WindowStage
    | AggregateStage | AccumulateStage | HavingStage | MapStage | SelectStage
    | EnrichStage | DebugStage
;

DeduplicateStage:
    'DEDUPLICATE' key=FieldRef 'WITHIN' ttl=Duration
;

FilterStage:
    'FILTER' condition=Expression
;

GroupByStage:
    'GROUP_BY' fields+=FieldRef[',']
;

WindowStage:
    'WINDOW' wname=ID type=WindowType
        '(' size=Duration (',' 'STEP' '=' step=Duration)? ')'
    | 'WINDOW' type=WindowType
        '(' size=Duration (',' 'STEP' '=' step=Duration)? ')'
;

WindowType:
    'tumbling' | 'sliding'
;

Duration:
    value=INT unit=/ms|[smhd]/
;

AggregateStage:
    'AGGREGATE' '{'
        assignments+=AggAssignment[',']
    '}'
;

AggAssignment:
    name=ID (':' type=TypeAnnotation)? '=' func=AggFunc '(' (field=FieldRef)? (',' param=Expression)? ')' ('OVER' window_ref=ID)?
;

TypeAnnotation:
    'int' | 'float' | 'str' | 'bool'
;

AggFunc:
    'avg' | 'sum' | 'min' | 'max' | 'count'
    | 'stddev' | 'first' | 'last'
    | 'percentile' | 'distinct_count'
;

AccumulateStage:
    'ACCUMULATE' '{'
        assignments+=AccumAssignment[',']
    '}'
;

AccumAssignment:
    name=ID '=' func=AccumFunc '(' field=FieldRef (',' param=Expression)? ')'
;

AccumFunc:
    'ema' | 'cumsum' | 'delta'
;

RateStage:
    'RATE' limit=INT 'PER' period=Duration
    ('ON_EXCESS' ':' on_excess=ExcessBehavior)?
;

ExcessBehavior:
    'DROP' | 'WARN' | 'ERROR'
;

FlattenStage:
    'FLATTEN' field=FieldRef
;

DistinctStage:
    'DISTINCT' field=FieldRef 'WITHIN' ttl=Duration
;

ThrottleStage:
    'THROTTLE' limit=INT 'PER' period=Duration
    ('OVERFLOW' ':' overflow=OverflowBehavior)?
    ('BUFFER' ':' buffer_size=INT)?
;

OverflowBehavior:
    'DROP' | 'BUFFER'
;

SampleStage:
    'SAMPLE' percentage=INT '%'
;

HavingStage:
    'HAVING' condition=Expression
;

MapStage:
    'MAP' '{'
        (bindings+=LetBinding[','] ',')?
        mappings+=MapAssignment[','] ','?
    '}'
;

LetBinding:
    'LET' name=ID '=' value=Expression
;

MapAssignment:
    target=ID '=' value=Expression
;

SelectStage:
    'SELECT' '[' fields+=SelectField[','] ']'
;

SelectField:
    alias=ID ':' source=ID
  | name=ID
;

PredictStage:
    'PREDICT' model=[ModelDef]
;

DebugStage:
    'DEBUG' ('LABEL' ':' label=STRING ','?)? ('FIELDS' ':' '[' fields+=FieldRef[','] ']')?
;

ValidateStage:
    'VALIDATE' 'SCHEMA' ':' schema=[SchemaDef]
    ('ON_ERROR' ':' validate_err=ValidateError)?
;

ValidateError:
    'SINK' 'TO' broker=[Broker] '::' topic=STRING
  | action=ValidateErrorAction
;

ValidateErrorAction:
    'SKIP' | 'DROP'
;

EnrichStage:
    'ENRICH' 'VIA' 'HTTP'
        'URL' ':' url=Expression
        ('METHOD' ':' method=HttpMethod)?
        ('TIMEOUT' ':' timeout=Duration)?
        'BIND' ':' bind=ID
        ('ON_ERROR' ':' enrich_err=EnrichError)?
    ';'
;

HttpMethod:
    'GET' | 'POST' | 'PUT'
;

EnrichError:
    'SINK' 'TO' broker=[Broker] '::' topic=STRING
  | 'DEFAULT' body=ObjectLiteral
  | action=EnrichErrorAction
;

EnrichErrorAction:
    'SKIP' | 'DROP'
;

// ─── ML model declarations ─────────────────────────────────────────
ModelDef:
    'MODEL' name=ID
        'SOURCE' ':' source=Expression
        'RUNTIME' ':' runtime=ModelRuntime
        ('FEATURES' ':' '[' features+=FieldRef[','] ']')?
        ('RETURNS' ':' '[' returns+=ID[','] ']')?
    ';'
;

ModelRuntime:
    'ONNX' | 'SKLEARN' | 'TORCH' | 'TFLITE' | 'CUSTOM'
;

// ─── Expression grammar (precedence climbing) ──────────────────────
Expression:
    operands+=AndExpr['or']
;

AndExpr:
    operands+=Comparison['and']
;

Comparison:
    left=Addition
    (op=CompOp right=Addition | nullCheck=NullCheck | inCheck=InCheck)?
;

CompOp:
    '>=' | '<=' | '==' | '!=' | '>' | '<'
;

NullCheck:
    'is' negated?='not' 'null'
;

InCheck:
    negated?='not' 'in' list=ListLiteral
;

ListLiteral:
    '[' items+=Expression[','] ']'
;

Addition:
    left=Multiplication op=AddOp right=Addition | left=Multiplication
;

AddOp:
    '+' | '-'
;

Multiplication:
    left=Coalesce op=MulOp right=Multiplication | left=Coalesce
;

MulOp:
    '*' | '/' | '%'
;

Coalesce:
    left=Unary ('??' right=Coalesce)?
;

Unary:
    op=UnaryOp operand=Unary | atom=Atom
;

UnaryOp:
    '-' | 'not'
;

Atom:
    ParenExpr | CaseExpr | MatchExpr | IfExpr | ForallExpr | ExistsExpr
    | EnvRef | FuncCall | OldRef | ChangedRef | UserFuncCall
    | FloatLiteral | IntLiteral | StringLiteral | BoolLiteral | FieldRef
;

ParenExpr:
    '(' expr=Expression ')'
;

IfExpr:
    'if' condition=Expression 'then' thenExpr=Expression 'else' elseExpr=Expression
;

CaseExpr:
    'case' '{' arms+=WhenArm ('else' '=>' elseExpr=Expression)? '}'
;

MatchExpr:
    'match' subject=Expression '{'
        arms+=MatchArm
        ('else' '=>' elseExpr=Expression)?
    '}'
;

MatchArm:
    'case' pattern=Expression '=>' result=Expression
;

WhenArm:
    'when' condition=Expression '=>' result=Expression
;

EnvRef:
    'env' '(' key=STRING (',' default=Expression)? ')'
;

OldRef:
    'old' '(' field=FieldRef ')'
;

ChangedRef:
    'changed' '(' field=FieldRef ')'
;

ForallExpr:
    'forall' '(' var=ID ('in' collection=FieldRef)? '=>' predicate=Expression ')'
;

ExistsExpr:
    'exists' '(' var=ID ('in' collection=FieldRef)? '=>' predicate=Expression ')'
;

UserFuncCall:
    name=ID '(' args+=Expression[','] ')'
;

FuncCall:
    name=ScalarFunc '(' (args+=Expression[','])? ')'
;

ScalarFunc:
    'abs' | 'round' | 'len' | 'lower' | 'upper' | 'floor' | 'ceil' | 'fmt'
    | 'trim' | 'contains' | 'starts_with' | 'ends_with' | 'split' | 'replace' | 'substring'
    | 'sqrt' | 'pow' | 'log' | 'log10' | 'exp'
    | 'to_int' | 'to_float' | 'to_str' | 'to_bool'
    | 'now' | 'timestamp_ms' | 'date_format' | 'date_diff'
    | 'matches' | 'extract'
;

BoolLiteral:
    val=BOOL
;

FloatLiteral:
    val=FLOAT
;

IntLiteral:
    val=INT
;

StringLiteral:
    val=STRING
;

FieldRef:
    segments+=ID['.'] (subscript=FieldSubscript)?
;

FieldSubscript:
    '[' neg?='-' index=INT ']'
;

// ─── Schema declarations ───────────────────────────────────────────
SchemaDef:
    'SCHEMA' name=ID (strictness=SchemaStrictness)?
        fields+=SchemaField
    ';'
;

SchemaStrictness:
    'STRICT' | 'LENIENT'
;

SchemaField:
    name=ID ':' type=SchemaFieldType optional?='?'
;

SchemaFieldType:
    SchemaObjectType | SchemaListType | SchemaScalarType
;

SchemaScalarType:
    name=ScalarTypeName
;

ScalarTypeName:
    'int' | 'float' | 'str' | 'bool'
;

SchemaObjectType:
    '{' fields+=SchemaField[','] '}'
;

SchemaListType:
    '[' element=SchemaFieldType ']'
;

// ─── Comments in DSL source files ──────────────────────────────────
Comment:
    /\/\/.*$/ | /\/\*[\s\S]*?\*\//
;
